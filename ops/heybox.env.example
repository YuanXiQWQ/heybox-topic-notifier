# 复制到 /etc/heybox-topic-notifier/，仅 root 可读；此示例不包含任何密钥。
STORAGE_READ_BACKEND=turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
PUBLIC_ORIGIN=https://heybox.yuanxiqwq.top
PORT=8000
# 仅正式切换且旧后台停止后开启；候选服务保持 false。
VM_POLLING_ENABLED=false
# 可选独立详情出口。两项同时设置；专用密钥至少 32 字符，服务端配置同一密钥。
# HEYBOX_DETAIL_RELAY_URL=https://YOUR_RELAY/v1/details
# HEYBOX_DETAIL_RELAY_TOKEN=
AUTH_PASSKEY_RP_ID=heybox.yuanxiqwq.top
AUTH_PASSKEY_EXPECTED_ORIGIN=https://heybox.yuanxiqwq.top
# 从既有生产配置安全转移其余认证、邮件和通知配置，不重新生成已有密钥。
# GOOGLE_CLIENT_ID=
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=
